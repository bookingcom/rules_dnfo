load("//dnfo:defs.bzl", "dnfo_image")

package(default_visibility = ["//visibility:public"])

dnfo_image(
    name = "minimal",
    accounts = {
        "groups": [
            {
                "gid": 65532,
                "groupname": "nonroot",
            },
        ],
        "users": [
            {
                "gid": 65532,
                "uid": 65532,
                "username": "nonroot",
            },
        ],
    },
    archs = [
        "x86_64",
        "aarch64",
    ],
    cmd = ["-l"],
    config = "dnfo.yaml",
    entrypoint = ["/bin/bash"],
    env = {
        "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "TERM": "xterm",
    },
    keyring = ["https://yum.oracle.com/RPM-GPG-KEY-oracle-ol10"],
    lock_only = False,
    packages = [
        "bash",
        "coreutils",
    ],
    repositories = [{
        "baseurl": "https://yum.oracle.com/repo/OracleLinux/OL10/baseos/latest/$basearch/",
        "gpgcheck": 1,
        "gpgkey": "https://yum.oracle.com/RPM-GPG-KEY-oracle-ol10",
        "id": "baseos",
        "name": "BaseOS",
    }],
    user = "nonroot",
    workdir = "/home",
)

dnfo_image(
    name = "minimal_flatten_all",
    archs = [
        "x86_64",
        "aarch64",
    ],
    config = "dnfo.yaml",
    contents = {
        "aarch64": "@minimal_aarch64_packages//:rpms",
        "x86_64": "@minimal_x86_64_packages//:rpms",
    },
    flatten_all_layers = True,
    lock_only = False,
    packages = [
        "bash",
        "coreutils",
    ],
)

dnfo_image(
    name = "minimal_flatten_dnfo",
    archs = [
        "x86_64",
        "aarch64",
    ],
    base = ":minimal",
    config = "dnfo.yaml",
    contents = {
        "aarch64": "@minimal_aarch64_packages//:rpms",
        "x86_64": "@minimal_x86_64_packages//:rpms",
    },
    files = {
        "/etc/test_config.txt": ":BUILD.bazel",
    },
    flatten_dnfo_layers = True,
    lock_only = False,
    packages = [
        "bash",
    ],
)
