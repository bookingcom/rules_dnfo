# Bzlmod
common --enable_bzlmod

# Registries
common --registry=https://bazel-contrib.github.io/rules_img --registry=https://bcr.bazel.build

# CI configuration profile
common:ci --color=yes
common:ci --show_progress_rate_limit=5
test:ci --test_output=errors
test:ci --test_summary=terse

# BuildBuddy remote cache / execution settings
common:buildbuddy --remote_timeout=3600
common:buildbuddy --noexperimental_remote_cache_chunking
common:buildbuddy-rbe --config=buildbuddy
common:buildbuddy-rbe --config=rbe
common:buildbuddy-rbe --jobs=100
build:buildbuddy-rbe --remote_download_outputs=toplevel
test:buildbuddy-rbe --remote_download_outputs=minimal

# RBE execution platforms via toolchains_buildbuddy
build:rbe --extra_execution_platforms=@buildbuddy_toolchain//:platform
build:rbe --host_platform=@buildbuddy_toolchain//:platform
build:rbe --spawn_strategy=remote
build:rbe --remote_local_fallback=true

# Import user configuration if present (e.g. API key, BES endpoint)
try-import %workspace%/.bazelrc.user
