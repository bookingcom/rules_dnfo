# gazelle:resolve starlark @dnf5-prebuilt//dnf5-prebuilt:defs.bzl @dnf5-prebuilt//dnf5-prebuilt:defs.bzl
# gazelle:resolve starlark @rules_containers_util//containers:defs.bzl @rules_containers_util//containers:defs.bzl
# gazelle:resolve starlark @rules_multirun//:defs.bzl @rules_multirun//:defs.bzl

load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_test")
load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@dnf5-prebuilt//dnf5-prebuilt:defs.bzl", "rpm_extract")

exports_files(
    glob(["*.bzl"]),
    visibility = ["//visibility:public"],
)

py_binary(
    name = "p11_kit_extract_bin",
    srcs = ["p11_kit_extract.py"],
    main = "p11_kit_extract.py",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "dnfo_image",
    srcs = ["dnfo_image.bzl"],
    visibility = ["//dnfo:__subpackages__"],
    deps = [
        ":p11_kit_extract",
        "@bazel_lib//lib:expand_template",
        "@bazel_lib//lib:write_source_files",
        "@dnf5-prebuilt//dnf5-prebuilt:defs.bzl",
        "@rules_containers_util//containers:defs",
        "@rules_img//img:base_images",
        "@rules_img//img:convert",
        "@rules_img//img:image",
        "@rules_img//img:layer",
        "@rules_img//img:load",
        "@rules_img//img:providers",
        "@rules_multirun//:defs",
    ],
)

rpm_extract(
    name = "test_ca_certificates_pki",
    dirs = ["usr/share/pki/ca-trust-source"],
    rpms = ["@certificates_x86_64_packages//:ca-certificates"],
)

py_test(
    name = "p11_kit_extract_test",
    srcs = ["p11_kit_extract_test.py"],
    data = [":test_ca_certificates_pki"],
    deps = [":p11_kit_extract_bin"],
)

bzl_library(
    name = "p11_kit_extract",
    srcs = ["p11_kit_extract.bzl"],
    visibility = ["//dnfo:__subpackages__"],
)
