"""Repository rules for translating dnfo.lock.json into Bazel external repositories."""

_BUILD_TMPL = """\
load("@rules_dnfo//dnfo/private:rpm.bzl", "rpm_filegroup")

package(default_visibility = ["//visibility:public"])

rpm_filegroup(
    name = "contents",
    lockfile = "{lockfile}",
    rpms = {rpms},
)
"""

_REPO_TMPL = """\
# Generated by translate_lock. DO NOT EDIT.
load("@rules_dnfo//dnfo/private:rpm.bzl", "rpm_import")

def dnfo_repositories():
{defs}
"""

_RPM_IMPORT_TMPL = """\
    rpm_import(
        name = "{name}",
        package_name = "{package_name}",
        version = "{version}",
        arch = "{arch}",
        url = "{url}",
        integrity = "{integrity}",
    )
"""

def _sanitize(name):
    clean = ""
    for c in name.elems():
        if c.isalnum() or c in ["_", "."]:
            clean += c
        else:
            clean += "_"
    return clean

def _translate_lock_impl(rctx):
    lock_content = rctx.read(rctx.attr.lock)
    lock_data = json.decode(lock_content)

    lock_file_copy = "lockfile_copy.json"
    rctx.file(lock_file_copy, lock_content, executable = False)

    target_name = rctx.attr.target_name if rctx.attr.target_name else rctx.name
    rpms = []
    defs = []

    packages = lock_data.get("packages", [])
    for pkg in packages:
        pkg_name = pkg.get("name", "")
        pkg_ver = pkg.get("version", "")
        pkg_arch = pkg.get("arch", "")
        pkg_url = pkg.get("url", "")
        pkg_integrity = pkg.get("integrity", "")

        repo_name = _sanitize("{}_{}_{}_{}".format(target_name, pkg_name, pkg_arch, pkg_ver))
        rpms.append("@{}//:file".format(repo_name))
        defs.append(_RPM_IMPORT_TMPL.format(
            name = repo_name,
            package_name = pkg_name,
            version = pkg_ver,
            arch = pkg_arch,
            url = pkg_url,
            integrity = pkg_integrity,
        ))

    rctx.file(
        "repositories.bzl",
        _REPO_TMPL.format(defs = "\n".join(defs)),
    )

    rctx.file(
        "BUILD.bazel",
        _BUILD_TMPL.format(
            lockfile = lock_file_copy,
            rpms = repr(rpms),
        ),
    )
    return None

translate_lock = repository_rule(
    implementation = _translate_lock_impl,
    doc = "Generates Bazel repository rules and contents filegroup from a dnfo.lock.json lockfile.",
    attrs = {
        "lock": attr.label(
            doc = "Label to dnfo.lock.json lockfile.",
            mandatory = True,
            allow_single_file = True,
        ),
        "target_name": attr.string(doc = "Optional base target name for generated repositories."),
    },
)
