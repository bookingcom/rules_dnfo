"""Implementation of the dnfo_image rule and macro."""

load("//dnfo/private:dnfo_lock.bzl", "dnfo_lock")

DNFO_TOOLCHAIN_TYPE = "//dnfo:toolchain_type"

def _dnfo_image_impl(ctx):
    dnfo_info = ctx.toolchains[Label(DNFO_TOOLCHAIN_TYPE)].dnfo_info

    if ctx.attr.output == "oci":
        output = ctx.actions.declare_directory(ctx.label.name)
        fmt = "oci"
    else:
        output = ctx.actions.declare_file(ctx.label.name + ".tar")
        fmt = "tar"

    args = ctx.actions.args()
    args.add("build")
    args.add("--output-format=" + fmt)

    if ctx.attr.architecture:
        args.add("--arch=" + ctx.attr.architecture)

    inputs = [ctx.file.config]
    transitive_inputs = [dnfo_info.files]

    if ctx.attr.contents:
        grp = ctx.attr.contents[OutputGroupInfo]
        if hasattr(grp, "lockfile"):
            lock_files = grp.lockfile.to_list()
            if lock_files:
                args.add("--lockfile=" + lock_files[0].path)
                inputs.append(lock_files[0])
        if hasattr(grp, "rpms"):
            rpm_list = grp.rpms.to_list()
            if rpm_list:
                args.add("--rpms=" + ",".join([f.path for f in rpm_list]))
                inputs.extend(rpm_list)

    args.add(ctx.file.config.path)
    args.add(output.path)

    ctx.actions.run(
        mnemonic = "DnfoImage",
        progress_message = "Building dnfo image %s" % output.short_path,
        executable = dnfo_info.dnfo,
        arguments = [args],
        inputs = depset(inputs, transitive = transitive_inputs),
        outputs = [output],
    )

    return [
        DefaultInfo(files = depset([output])),
    ]

_dnfo_image = rule(
    implementation = _dnfo_image_impl,
    doc = "Builds an OCI container image or layer archive from a dnfo YAML configuration.",
    attrs = {
        "config": attr.label(
            mandatory = True,
            allow_single_file = [".yaml", ".yml"],
            doc = "The dnfo.yaml configuration file.",
        ),
        "contents": attr.label(
            providers = [OutputGroupInfo],
            doc = "Label to the contents repository generated by translate_lock (e.g. @lock_repo//:contents).",
        ),
        "architecture": attr.string(
            default = "x86_64",
            doc = "Target architecture for the container image.",
        ),
        "output": attr.string(
            default = "oci",
            values = ["oci", "tar"],
            doc = "Output format: 'oci' directory layout or 'tar' archive.",
        ),
        "tag": attr.string(
            doc = "Optional tag for the image.",
        ),
    },
    toolchains = [Label(DNFO_TOOLCHAIN_TYPE)],
)

def dnfo_image(name, config, contents = None, architecture = "x86_64", output = "oci", tag = "", gpgcheck = True, keyring = [], **kwargs):
    """Builds an OCI container image from RPM packages declared in a dnfo YAML specification.

    Also generates a `<name>.lock` target that can be executed with `bazel run` to refresh
    the companion `.lock.json` file in the workspace source tree.

    Args:
      name: Target name for the generated container image.
      config: YAML file specifying image contents, entrypoint, cmd, environment, and accounts.
      contents: Optional label to the contents repository generated by translate_lock.
      architecture: Target CPU architecture (e.g. x86_64, aarch64).
      output: Output format ('oci' for directory layout, 'tar' for layer tarball).
      tag: Optional container image tag.
      gpgcheck: Whether to validate package signatures against GPG keys during locking.
      keyring: Optional list of local GPG key files.
      **kwargs: Standard rule attributes (e.g. visibility, tags).
    """
    _dnfo_image(
        name = name,
        config = config,
        contents = contents,
        architecture = architecture,
        output = output,
        tag = tag,
        **kwargs
    )

    # Generate companion .lock target if config is a local file
    config_label = native.package_relative_label(config)
    if config_label.workspace_name == "" and config_label.package == native.package_name():
        dnfo_lock(
            name = name + ".lock",
            config = config,
            arch = architecture,
            gpgcheck = gpgcheck,
            keyring = keyring,
            **kwargs
        )
