"""Repository and build rules for importing remote RPM packages."""

RPM_IMPORT_TMPL = """\
# Generated by rpm_import. DO NOT EDIT.
package(default_visibility = ["//visibility:public"])

exports_files(["{filename}"])

filegroup(
    name = "file",
    srcs = ["{filename}"],
)
"""

def _rpm_import_impl(rctx):
    filename = rctx.attr.url.rsplit("/", 1)[-1]
    if not filename.endswith(".rpm"):
        filename = rctx.attr.package_name + ".rpm"

    rctx.download(
        url = [rctx.attr.url],
        output = filename,
        integrity = rctx.attr.integrity if rctx.attr.integrity else "",
    )

    rctx.file("BUILD.bazel", RPM_IMPORT_TMPL.format(filename = filename))
    return None

rpm_import = repository_rule(
    implementation = _rpm_import_impl,
    doc = "Downloads an RPM package with integrity checking and exposes it as a target.",
    attrs = {
        "url": attr.string(mandatory = True, doc = "Download URL for the RPM package."),
        "integrity": attr.string(doc = "Subresource Integrity (SRI) checksum (e.g. sha256-...)."),
        "package_name": attr.string(mandatory = True, doc = "Name of the RPM package."),
        "version": attr.string(doc = "Package version-release EVR."),
        "arch": attr.string(doc = "Architecture of the package."),
    },
)

def _rpm_filegroup_impl(ctx):
    lockfile = depset([ctx.file.lockfile])
    rpms = depset(ctx.files.rpms)
    return [
        DefaultInfo(files = depset(transitive = [lockfile, rpms])),
        OutputGroupInfo(
            lockfile = lockfile,
            rpms = rpms,
        ),
    ]

rpm_filegroup = rule(
    implementation = _rpm_filegroup_impl,
    doc = "Groups resolved RPM packages and lockfile together.",
    attrs = {
        "lockfile": attr.label(
            doc = "Label to the dnfo.lock.json lockfile.",
            allow_single_file = True,
            mandatory = True,
        ),
        "rpms": attr.label_list(
            doc = "Labels of the resolved RPM files.",
            allow_files = True,
            mandatory = True,
        ),
    },
)
