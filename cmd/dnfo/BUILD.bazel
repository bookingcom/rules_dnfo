load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//dnfo:toolchain.bzl", "dnfo_toolchain")
load(":dist.bzl", "dnfo_distribution", "multiplatform_dnfo_dist")

string_flag(
    name = "version",
    build_setting_default = "",
    visibility = ["//visibility:public"],
)

go_library(
    name = "dnfo_lib",
    srcs = ["main.go"],
    importpath = "github.com/bookingcom/rules_dnfo/cmd/dnfo",
    visibility = ["//visibility:private"],
    deps = [
        "//pkg/dnfo",
        "@in_gopkg_yaml_v3//:yaml_v3",
    ],
)

go_binary(
    name = "dnfo",
    embed = [":dnfo_lib"],
    visibility = ["//visibility:public"],
)

dnfo_toolchain(
    name = "dnfo_toolchain",
    dnfo = ":dnfo",
    visibility = ["//visibility:public"],
)

dnfo_distribution(
    name = "archive",
    binary = ":dnfo",
)

multiplatform_dnfo_dist(
    name = "dist",
    target = ":archive",
    visibility = ["//visibility:public"],
)
