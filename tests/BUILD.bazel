load("@aspect_rules_py//py:defs.bzl", "py_binary", "py_test")
load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("//dnfo:defs.bzl", "dnfo_image")

package(default_visibility = ["//visibility:public"])

dnfo_image(
    name = "test_defaults_image",
    archs = ["x86_64"],
    lock_only = False,
)

dnfo_image(
    name = "test_child_image",
    archs = ["x86_64"],
    base = ":test_defaults_image",
    lock_only = False,
)

dnfo_image(
    name = "test_custom_base",
    archs = ["x86_64"],
    cmd = ["--flag"],
    entrypoint = ["/usr/bin/my-app"],
    lock_only = False,
    user = "1001",
    workdir = "/app",
)

dnfo_image(
    name = "test_inherit_custom",
    archs = ["x86_64"],
    base = ":test_custom_base",
    lock_only = False,
)

dnfo_image(
    name = "test_crypto_policy_image",
    archs = ["x86_64"],
    crypto_policy = "DEFAULT",
    lock_only = False,
)

dnfo_image(
    name = "test_crypto_policy_fips_image",
    archs = ["x86_64"],
    crypto_policy = "FIPS",
    lock_only = False,
)

dnfo_image(
    name = "test_accounts_image",
    accounts = {
        "groups": [
            {
                "gid": 10,
                "groupname": "wheel",
                "members": ["customuser"],
            },
            {
                "gid": 2000,
                "groupname": "customgroup",
            },
        ],
        "users": [
            {
                "gid": 2000,
                "uid": 2000,
                "username": "customuser",
            },
        ],
    },
    archs = ["x86_64"],
    lock_only = False,
)

py_binary(
    name = "compare_image_structure_bin",
    srcs = ["compare_image_structure.py"],
    main = "compare_image_structure.py",
)

py_test(
    name = "compare_image_structure_test",
    srcs = ["compare_image_structure_test.py"],
    deps = [":compare_image_structure_bin"],
)

py_test(
    name = "sbom_test",
    srcs = ["sbom_test.py"],
    data = [
        "//examples/certificates:certificates_spdx",
        "//examples/minimal:minimal_aarch64_spdx",
        "//examples/minimal:minimal_cyclonedx",
        "//examples/minimal:minimal_spdx",
        "//examples/minimal:minimal_x86_64_spdx",
    ],
)

py_test(
    name = "image_config_test",
    srcs = ["image_config_test.py"],
    data = [
        ":test_defaults_image",
        ":test_inherit_custom",
    ],
)

py_test(
    name = "crypto_policy_test",
    srcs = ["crypto_policy_test.py"],
    data = [
        ":test_crypto_policy_fips_image_files_layer",
        ":test_crypto_policy_image_files_layer",
    ],
)

py_test(
    name = "accounts_test",
    srcs = ["accounts_test.py"],
    data = [":test_accounts_image_base_layer"],
)

py_test(
    name = "oci_metadata_test",
    srcs = ["oci_metadata_test.py"],
    data = [
        ":test_oci_child_paths_dnfo_paths_layer",
        ":test_oci_metadata_dnfo",
        ":test_oci_metadata_dnfo_base_layer",
        ":test_oci_metadata_dnfo_files_layer",
    ],
)

bzl_library(
    name = "image_structure",
    srcs = ["image_structure.bzl"],
    deps = ["@rules_img//img:providers"],
)

dnfo_image(
    name = "test_oci_child_paths_dnfo",
    archs = ["x86_64"],
    base = ":test_oci_metadata_dnfo",
    config = "test_oci_child_paths.dnfo.yaml",
    lock_only = False,
    paths = [{
        "mode": "0700",
        "path": "/opt/custom",
        "type": "directory",
    }],
)

dnfo_image(
    name = "test_oci_metadata_dnfo",
    archs = ["x86_64"],
    config = "test_oci_metadata.dnfo.yaml",
    env_file = ":test.env",
    lock_only = False,
    paths = [
        {
            "gid": 1000,
            "mode": "0755",
            "path": "/var/log/app",
            "type": "directory",
            "uid": 1000,
        },
        {
            "gid": 0,
            "mode": "0644",
            "path": "/var/run/app.pid",
            "type": "empty-file",
            "uid": 0,
        },
        {
            "path": "/etc/ssl/cert.pem",
            "target": "/etc/pki/tls-ca-bundle.pem",
            "type": "symlink",
        },
    ],
    ports = [
        "80/tcp",
        "8080",
    ],
    volumes = [
        "/var/log",
        "/var/lib/data",
    ],
)
